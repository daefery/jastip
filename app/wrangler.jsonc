{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jastip",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/paypal/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "jastip", "database_id": "9257a8a8-1b3a-4ebb-94d8-ca4a89dd8cec", "migrations_dir": "migrations" }
  ],
  "vars": { "PAYPAL_BASE": "https://api-m.sandbox.paypal.com" },
  "observability": { "enabled": true }
}
